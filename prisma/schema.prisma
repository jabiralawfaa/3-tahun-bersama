generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Post {
  id        String   @id @default(cuid())
  title     String
  content   String?
  published Boolean  @default(false)
  authorId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Arsip kenangan kelulusan — satu entri per orang (kode nama).
model Memory {
  id              String   @id @default(cuid())
  /// Kode nama rahasia (diketik di gerbang)
  code            String   @unique
  /// URL slug untuk /for/[slug]
  slug            String   @unique
  name            String
  role            String   @default("Teman Kelas")
  themeLabel      String   @default("Interactive Design Canvas & Editorial Motion")
  /// Warna aksen utama (hex, mis. #e8a23d) — per orang
  accent          String   @default("#e8a23d")
  /// Warna aksen sekunder (hex)
  accentSoft      String   @default("#d96a4f")
  /// Warna latar canvas (hex)
  background      String   @default("#13131f")
  /// Jenis dekorasi SVG: bezier | constellation | orbit
  decoration      String   @default("bezier")
  /// Path file audio (relatif /public, mis. /audio/starla.mp3)
  audioSrc        String
  songTitle       String
  songArtist      String
  /// String format Enhanced LRC (mode "lrc"). Kosong jika mode "plain".
  enhancedLrc     String   @default("")
  /// JSON string[] — ucapan per baris (mode "plain", tanpa LRC).
  /// Durasi lagu dibagi rata sesuai jumlah baris.
  plainLines      String   @default("[]")
  /// JSON string LineConfig[] (refleksi + preset animasi per baris)
  lineConfig      String   @default("[]")
  /// JSON string SvgIcon[] — pustaka ikon SVG animasi. Tiap baris lirik
  /// memakai satu ikon (bergantian kiri/kanan); mode "outline" | "fill".
  svgIcons        String   @default("[]")
  /// Tata letak ikon mode ucapan biasa: "crowd" (ramai) | "single" (individual)
  iconLayout      String   @default("crowd")
  /// Pesan penutup saat lagu selesai
  finalMessage    String
  finalFrameLabel String   @default("Final_Confession.tsx")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

/// Pustaka gambar (menu Media di dashboard). File disimpan di Vercel Blob,
/// baris ini hanya menyimpan nama + URL-nya. Dipilih per baris ucapan lewat
/// LineConfig.imageId / imageUrl.
model Media {
  id        String   @id @default(cuid())
  /// Nama yang diberikan admin (mudah dikenali di dropdown)
  name      String
  /// URL publik file di Blob
  url       String
  mime      String   @default("image/webp")
  size      Int      @default(0)
  width     Int      @default(0)
  height    Int      @default(0)
  createdAt DateTime @default(now())
}
